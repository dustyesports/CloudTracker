# Copy to .env for local testing (never commit .env)

# Required: your Albanian Courier POD / tracking number
TRACKING_NUMBER=123456789

# Required: secret ntfy topic (acts as a password — pick something unguessable)
NTFY_TOPIC=cloudtracker-your-secret-topic-name

# Optional: override tracking page URL (default: https://al.albaniancourier.al/track-trace/)
# TRACKING_URL=https://www.albaniancourier.al/ks/track-p.php?podNr=123456789

# Optional: keyword to watch for (default: Vore)
# KEYWORD=Vore

# Optional: ntfy server (default: https://ntfy.sh)
# NTFY_SERVER=https://ntfy.sh

# Optional: page load timeout in milliseconds (default: 90000)
# PAGE_TIMEOUT_MS=90000

# Optional: local state file path (default: .tracker-state.json)
# STATE_FILE=.tracker-state.json
